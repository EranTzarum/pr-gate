 "tier_rules": {
  "note": "Copied as data from pr-gate scripts/pr_context.py (RISK, TIER_CATS, NON_CODE) on 2026-10-22. Crew scores a ticket before any diff exists, so the categories match the brief text and the risk paths match the write set.",
  "non_code": "\\.md$|^docs/|(^|/)tests?/|\\.test\\.|_test\\.|(^|/)test_|lock(file)?\\.|package-lock|\\.snap$|\\.json$",
  "risk_paths": {
   "migration": "(^|/)migrations?/|\\.sql$",
   "auth": "(^|/)auth(n|z|entication|orization)?([/._-]|$)|\\brls\\b|_rls|rls_|polic(y|ies)|permissions?",
   "workflow": "^\\.github/workflows/",
   "payment": "payment|billing|stripe|checkout|invoice|subscription"
  },
  "risk_path_weight": 3,
  "categories": {
   "secrets/perms": [
    2,
    "chmod|0o?600|permission|credential|secret|auth\\.json|api[_-]?key|password|private key"
   ],
   "exec/shell": [
    2,
    "subprocess|exec(Sync|File)?\\(|spawn\\(|\\bshell\\b|eval\\(|child_process"
   ],
   "guards": [
    2,
    "\\bdeny\\b|allowlist|denylist|guard|sanitiz|escape|unquote|shlex"
   ],
   "destructive": [
    2,
    "\\bdrop\\b|rmtree|rm -rf|unlink\\(|truncate|force[-_ ]push|--force|reset --hard"
   ],
   "db-security": [
    2,
    "row level|security definer|\\bgrant\\b|\\brevoke\\b|service_role|tenant|auth\\.uid"
   ],
   "concurrency": [
    1,
    "\\block\\b|mutex|transaction|for update|idempot|\\brace\\b"
   ],
   "isolation": [
    1,
    "cache|session|sign ?out|logout|user_?id"
   ]
  },
  "strong_at": 5,
  "critical_at": 10
 },
